# Infrastructure partagée AKILIYA — Variables d'environnement
# Copier en .env.infra sur le VPS (/home/deploy/infra/.env.infra)
# NE JAMAIS COMMITTER CE FICHIER

# ── Traefik / Let's Encrypt ──────────────────────────────────────────────────
ACME_EMAIL=devops@akiliya.com

# ── PostgreSQL superuser (pour les scripts d'init) ───────────────────────────
POSTGRES_SUPERUSER=akiliya_admin
POSTGRES_SUPERPASSWORD=CHANGE_ME_STRONG_PASSWORD_32CHARS

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ── Passwords databases par SaaS (utilisés dans 01-create-databases.sh) ─────
AKITEXT_DB_PASSWORD=CHANGE_ME_AKITEXT_PASSWORD
# SAAS2_DB_PASSWORD=CHANGE_ME_SAAS2_PASSWORD
